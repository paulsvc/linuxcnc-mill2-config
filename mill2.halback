# Generated by PNCconf at Sun Dec  8 08:58:49 2024
# Using LinuxCNC version:  Master (2.9)
# If you make changes to this file, they will be
# overwritten when you run PNCconf again

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt pid names=pid.x,pid.y,pid.z,pid.s

addf motion-command-handler   servo-thread
addf motion-controller        servo-thread
addf pid.x.do-pid-calcs       servo-thread
addf pid.y.do-pid-calcs       servo-thread
addf pid.z.do-pid-calcs       servo-thread
addf pid.s.do-pid-calcs       servo-thread


loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt debounce cfg=3
addf debounce.0 servo-thread
setp debounce.0.delay 5
addf lcec.read-all servo-thread
addf lcec.write-all servo-thread
# external output signals


# external input signals


#*******************
#  AXIS X JOINT 0
#*******************

# --- Composant de conversion pour le feedback du codeur ---
#loadrt conv_s32_float names=y_pos_conv,z_pos_conv,ddt_conv, 

setp   pid.x.Pgain     [JOINT_0]P
setp   pid.x.Igain     [JOINT_0]I
setp   pid.x.Dgain     [JOINT_0]D
setp   pid.x.bias      [JOINT_0]BIAS
setp   pid.x.FF0       [JOINT_0]FF0
setp   pid.x.FF1       [JOINT_0]FF1
setp   pid.x.FF2       [JOINT_0]FF2
setp   pid.x.deadband  [JOINT_0]DEADBAND
setp   pid.x.maxoutput [JOINT_0]MAX_OUTPUT
setp   pid.x.error-previous-target true

net x-index-enable  <=> pid.x.index-enable
net x-enable        =>  pid.x.enable
net x-pos-cmd       =>  pid.x.command
#net x-vel-cmd       =>  pid.x.command-deriv
net x-output        =>  pid.x.output

# --- PID Connections ---
net x-pos-cmd    joint.0.motor-pos-cmd  => pid.x.command

# Permet au signal d'index de l'axe de fonctionner avec le PID
net x-index-enable  joint.0.index-enable <=> pid.x.index-enable

# Connecte l'entrée physique du codeur (entier s32) à l'entrée du convertisseur

setp lcec.0.EL5101_X.enc-pos-scale [JOINT_0]INPUT_SCALE
net x-index-enable joint.0.index-enable	lcec.0.EL5101_X.enc-index-c-enable
setp lcec.0.EL4034.aout-0-scale [JOINT_0]OUTPUT_SCALE

# Connecte la sortie du convertisseur (flottant) au signal de feedback du PID
net x-pos-fb      joint.0.motor-pos-fb <= lcec.0.EL5101_X.enc-pos => pid.x.feedback


# --- X-Axis Analog Connections ---
# Connect the PID output to the analog value pin
net x-output pid.x.output => lcec.0.EL4034.aout-0-value


# The joint.0.amp-enable-out signal enables both the digital output for the
# servo drive (on the EL2828) and the analog output channel (on the EL4034).
# --- X-Axis Master Enable Signal ---
net x-enable joint.0.amp-enable-out => pid.x.enable
net x-enable => lcec.0.EL2008_1.dout-2  #EL2028 P2
net x-enable => lcec.0.EL4034.aout-0-enable


# ---PWM Generator signals/setup---


# ---setup home / limit switch signals---
# 1. Connect the physical EtherCAT input to the debounce component's input
net x-home-sw-raw     lcec.0.EL1018_1.din-1 => debounce.0.2.in #EL1018 P2

# 2. Connect the debounce component's output to the joint's home switch input
net x-home-sw-debounced     debounce.0.2.out => joint.0.home-sw-in

#net x-home-sw  		lcec.0.EL1018_1.din-1   		=>  joint.0.home-sw-in #EL1018 P5
net x-neg-limit  	lcec.0.EL1018_1.din-5-not   	=>  joint.0.neg-lim-sw-in #EL1018 P7
net x-pos-limit     lcec.0.EL1018_1.din-3-not 		=>  joint.0.pos-lim-sw-in #EL1018 P6

#*******************
#  AXIS Y JOINT 1
#*******************


setp   pid.y.Pgain     [JOINT_1]P
setp   pid.y.Igain     [JOINT_1]I
setp   pid.y.Dgain     [JOINT_1]D
setp   pid.y.bias      [JOINT_1]BIAS
setp   pid.y.FF0       [JOINT_1]FF0
setp   pid.y.FF1       [JOINT_1]FF1
setp   pid.y.FF2       [JOINT_1]FF2
setp   pid.y.deadband  [JOINT_1]DEADBAND
setp   pid.y.maxoutput [JOINT_1]MAX_OUTPUT
setp   pid.y.error-previous-target true

net y-index-enable  =>  pid.y.index-enable
net y-pos-cmd       =>  pid.y.command
net y-pos-fb        =>  pid.y.feedback
net y-output        <=  pid.y.output

# --- PID Connections ---
net y-pos-cmd    joint.1.motor-pos-cmd  => pid.y.command

# Permet au signal d'index de l'axe de fonctionner avec le PID
net y-index-enable  joint.1.index-enable <=> pid.y.index-enable

# La sortie du PID sera utilisée pour la commande analogique
net y-output      <= pid.y.output

# Le retour de position (feedback) alimente le PID
net y-pos-fb      => pid.y.feedback
# Permet au signal d'index de l'axe de fonctionner avec le PID
net y-index-enable  joint.1.index-enable <=> pid.y.index-enable

setp lcec.0.EL5101_Y.enc-pos-scale [JOINT_1]INPUT_SCALE
net y-index-enable joint.1.index-enable	lcec.0.EL5101_Y.enc-index-c-enable
setp lcec.0.EL4034.aout-2-scale [JOINT_1]OUTPUT_SCALE

# Connecte la sortie du convertisseur (flottant) au signal de feedback du PID
net y-pos-fb      joint.1.motor-pos-fb <= lcec.0.EL5101_Y.enc-pos => pid.y.feedback


# --- Y-Axis Analog Connections ---
# Connect the PID output to the analog value pin
net y-output pid.y.output => lcec.0.EL4034.aout-2-value


# The joint.0.amp-enable-out signal enables both the digital output for the
# servo drive (on the EL2828) and the analog output channel (on the EL4034).
# --- Y-Axis Master Enable Signal ---
net y-enable joint.1.amp-enable-out => pid.y.enable
net y-enable => lcec.0.EL2008_1.dout-4  #EL2028 P
net y-enable => lcec.0.EL4034.aout-2-enable


# ---setup home / limit switch signals---
# 1. Connect the physical EtherCAT input to the debounce component's input
net y-home-sw-raw     lcec.0.EL1018_1.din-6 => debounce.0.0.in #EL1018 P4

# 2. Connect the debounce component's output to the joint's home switch input
net y-home-sw-debounced     debounce.0.0.out => joint.1.home-sw-in

#net y-home-sw   lcec.0.EL1018_1.din-6 => joint.1.home-sw-in #EL1018 P4
net y-neg-limit lcec.0.EL1018_1.din-2-not => joint.1.neg-lim-sw-in #EL1018 P2 DRV2 P32
net y-pos-limit lcec.0.EL1018_1.din-4-not => joint.1.pos-lim-sw-in #EL1018 P3 DRV2 P31

#*******************
#  AXIS Z JOINT 2
#*******************

setp   pid.z.Pgain     [JOINT_2]P
setp   pid.z.Igain     [JOINT_2]I
setp   pid.z.Dgain     [JOINT_2]D
setp   pid.z.bias      [JOINT_2]BIAS
setp   pid.z.FF0       [JOINT_2]FF0
setp   pid.z.FF1       [JOINT_2]FF1
setp   pid.z.FF2       [JOINT_2]FF2
setp   pid.z.deadband  [JOINT_2]DEADBAND
setp   pid.z.maxoutput [JOINT_2]MAX_OUTPUT
setp   pid.z.error-previous-target true

net z-index-enable  =>  pid.z.index-enable
net z-enable        =>  pid.z.enable
net z-pos-cmd       =>  pid.z.command
net z-output        <=  pid.z.output


#############################################

# --- PID Connections ---
net z-pos-cmd    joint.2.motor-pos-cmd  => pid.z.command

# Permet au signal d'index de l'axe de fonctionner avec le PID
net z-index-enable  joint.2.index-enable <=> pid.z.index-enable

# La sortie du PID sera utilisée pour la commande analogique
net z-output      <= pid.z.output

# Le retour de position (feedback) alimente le PID
net z-pos-fb      => pid.z.feedback
# Permet au signal d'index de l'axe de fonctionner avec le PID
net z-index-enable  joint.2.index-enable <=> pid.z.index-enable

# Connecte l'entrée physique du codeur (entier s32) à l'entrée du convertisseur

setp lcec.0.EL5101_Z.enc-pos-scale [JOINT_2]INPUT_SCALE
net z-index-enable joint.2.index-enable	lcec.0.EL5101_Z.enc-index-c-enable
setp lcec.0.EL4034.aout-1-scale [JOINT_2]OUTPUT_SCALE

# Connecte la sortie du convertisseur (flottant) au signal de feedback du PID
net z-pos-fb      joint.2.motor-pos-fb <= lcec.0.EL5101_Z.enc-pos => pid.z.feedback


# --- Z-Axis Analog Connections ---
# Connect the PID output to the analog value pin
net z-output pid.z.output => lcec.0.EL4034.aout-1-value


# The joint.0.amp-enable-out signal enables both the digital output for the
# servo drive (on the EL2828) and the analog output channel (on the EL4034).
# --- Z-Axis Master Enable Signal ---
net z-enable joint.2.amp-enable-out => pid.z.enable
net z-enable => lcec.0.EL2008_1.dout-6  #EL2028 P
net z-enable => lcec.0.EL4034.aout-1-enable

# ---PWM Generator signals/setup---

# ---Encoder feedback signals/setup---

# ---setup home / limit switch signals---

# ---setup home / limit switch signals---
# 1. Connect the physical EtherCAT input to the debounce component's input
net z-home-sw-raw     lcec.0.EL1018_1.din-7 => debounce.0.1.in #EL1018 P8

# 2. Connect the debounce component's output to the joint's home switch input
net z-home-sw-debounced     debounce.0.1.out => joint.2.home-sw-in

#net z-home-sw     lcec.0.EL1018_1.din-7   		=>  joint.2.home-sw-in #EL1018 P8
net z-neg-limit   lcec.0.EL1018_2.din-0-not  	=>  joint.2.neg-lim-sw-in #EL1018 P1
net z-pos-limit   lcec.0.EL1018_2.din-2-not 	=>  joint.2.pos-lim-sw-in #EL1018 P2

#*******************
#  SPINDLE
#*******************

setp   pid.s.Pgain     [SPINDLE_0]P
setp   pid.s.Igain     [SPINDLE_0]I
setp   pid.s.Dgain     [SPINDLE_0]D
setp   pid.s.bias      [SPINDLE_0]BIAS
setp   pid.s.FF0       [SPINDLE_0]FF0
setp   pid.s.FF1       [SPINDLE_0]FF1
setp   pid.s.FF2       [SPINDLE_0]FF2
setp   pid.s.deadband  [SPINDLE_0]DEADBAND
setp   pid.s.maxoutput [SPINDLE_0]MAX_OUTPUT
setp   pid.s.error-previous-target true

net spindle-index-enable  =>  pid.s.index-enable
net spindle-enable        =>  pid.s.enable
net spindle-vel-cmd-rpm     => pid.s.command
net spindle-vel-fb-rpm      => pid.s.feedback
net spindle-output        <=  pid.s.output

# ---setup spindle control signals---

net spindle-vel-cmd-rps        <=  spindle.0.speed-out-rps
net spindle-vel-cmd-rps-abs    <=  spindle.0.speed-out-rps-abs
net spindle-vel-cmd-rpm        <=  spindle.0.speed-out
net spindle-vel-cmd-rpm-abs    <=  spindle.0.speed-out-abs
net spindle-enable             <=  spindle.0.on
net spindle-cw                 <=  spindle.0.forward
net spindle-cw					=> lcec.0.EL2008_1.dout-5
net spindle-ccw                <=  spindle.0.reverse
net spindle-ccw 				=>	lcec.0.EL2008_1.dout-7
net spindle-brake              <=  spindle.0.brake
net spindle-revs               =>  spindle.0.revs
net spindle-at-speed           =>  spindle.0.at-speed
net spindle-vel-fb-rps         =>  spindle.0.speed-in
net spindle-index-enable      <=>  spindle.0.index-enable

# ---Setup spindle at speed signals---

sets spindle-at-speed true
#net spindle-vel-cmd-rpm => lcec.0.EL4034.aout-3-value
setp lcec.0.EL4034.aout-3-scale [SPINDLE_0]OUTPUT_SCALE
net spindle-enable lcec.0.EL4034.aout-3-enable

#******************************
# connect miscellaneous signals
#******************************

#  ---HALUI signals---

net axis-select-x  halui.axis.x.select
net jog-x-pos      halui.axis.x.plus
net jog-x-neg      halui.axis.x.minus
net jog-x-analog   halui.axis.x.analog
net x-is-homed     halui.joint.0.is-homed
net axis-select-y  halui.axis.y.select
net jog-y-pos      halui.axis.y.plus
net jog-y-neg      halui.axis.y.minus
net jog-y-analog   halui.axis.y.analog
net y-is-homed     halui.joint.1.is-homed
net axis-select-z  halui.axis.z.select
net jog-z-pos      halui.axis.z.plus
net jog-z-neg      halui.axis.z.minus
net jog-z-analog   halui.axis.z.analog
net z-is-homed     halui.joint.2.is-homed
net jog-selected-pos      halui.axis.selected.plus
net jog-selected-neg      halui.axis.selected.minus
net spindle-manual-cw     halui.spindle.0.forward
net spindle-manual-ccw    halui.spindle.0.reverse
net spindle-manual-stop   halui.spindle.0.stop
net machine-is-on         halui.machine.is-on
net jog-speed             halui.axis.jog-speed
net MDI-mode              halui.mode.is-mdi

#  ---coolant signals---

net coolant-mist      <=  iocontrol.0.coolant-mist
net coolant-flood iocontrol.0.coolant-flood => lcec.0.EL2008_1.dout-3

#  ---probe signal---

net probe-in     =>  motion.probe-input

#  ---motion control signals---

net in-position               <=  motion.in-position
net machine-is-enabled        <=  motion.motion-enabled

#  ---digital in / out signals---

#  ---estop signals---
net estop-out     <=  iocontrol.0.user-enable-out
net estop-out => lcec.0.EL2828.dout-1 #EL2828 P2/10
net estop-out     =>  iocontrol.0.emc-enable-in

#  ---manual tool change signals---

net tool-change-request    <= iocontrol.0.tool-change
net tool-change-confirmed  => iocontrol.0.tool-changed
net tool-number            <= iocontrol.0.tool-prep-number

#  ---Use external manual tool change dialog---

loadusr -W hal_manualtoolchange
net tool-change-request    =>  hal_manualtoolchange.change
net tool-change-confirmed  <=  hal_manualtoolchange.changed
net tool-number            =>  hal_manualtoolchange.number

#  ---ignore tool prepare requests---
net tool-prepare-loopback   iocontrol.0.tool-prepare      =>  iocontrol.0.tool-prepared

